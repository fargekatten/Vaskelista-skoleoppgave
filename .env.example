# Docker: copy to .env (used by docker-compose.yml). Start with: docker compose up --build
POSTGRES_PASSWORD=change-me
# Initial password for the users inger, lisa, leander and vegard (created on first start).
INITIAL_PASSWORD=change-me-too

# Local development without Docker: copy to .env.local.
# The Docker database has no published port; to use it from `npm run dev`, temporarily add a ports mapping.
# In production (Vercel/Neon) set DATABASE_URL to the Neon connection string.
DATABASE_URL=postgres://vaskelista:change-me@localhost:5432/vaskelista
